# Paste the connection string from Atlas (Connect > Drivers).
# Replace <password> with the database user's password.
# If the password has special characters (@ : / ? # %), URL-encode them.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database
MONGODB_DB=AgentBreak
STORAGE_BACKEND=auto
MONGO_TIMEOUT_MS=3000

# Local port for the FastAPI API
PORT=8000

# Service-to-service authentication and simulator safety
ENVIRONMENT=development
BACKEND_SERVICE_TOKEN=replace-with-a-long-random-secret
SIMULATOR_NETWORK_MODE=offline
MAX_ATTEMPTS_PER_CASE=10

# Preferred OpenAI configuration (not required in deterministic mock mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=60

# Optional OpenRouter fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=60

# Phase 2 external-agent campaign
ATTACK_LLM_PROVIDER=auto
TARGET_LLM_PROVIDER=auto
TARGET_LLM_MODEL=
TEST_AGENT_SERVICE_TOKEN=replace-with-a-separate-long-random-secret
ALLOWED_TEST_AGENT_ENDPOINTS=http://127.0.0.1:8090,http://localhost:8090,http://external-test-agent:8090
TEST_AGENT_TIMEOUT_SECONDS=20
